DB_HOST=localhost
DB_PORT=3306
DB_USER=pharmacompare_app
DB_PASSWORD=paste_the_password_you_chose_here
DB_NAME=pharmacompare

# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_your_own_random_value_do_not_reuse_this_placeholder

FRONTEND_ORIGIN=http://localhost:5173

# --- OCR -------------------------------------------------------------------
# auto    : use cloud OCR when a key is set below, else local EasyOCR (default)
# cloud   : cloud only - fails the upload instead of quietly falling back
# easyocr : local only, never calls out (no prescription leaves the machine)
OCR_PROVIDER=auto

# Google Cloud Vision key, for reading HANDWRITTEN prescriptions, which local
# EasyOCR cannot do. Leave blank to stay fully local.
# Get one: Google Cloud console > enable "Cloud Vision API" > Credentials >
# Create credentials > API key. Restrict it to the Vision API.
# NOTE: with this set, prescription images are sent to Google for processing.
GOOGLE_VISION_API_KEY=
CLOUD_OCR_TIMEOUT_SECONDS=30

# --- Medicine explanations ("Explain this medicine") ------------------------
# Google Gemini. Without a key the app uses a deterministic explainer built
# from the stored medicine record - the feature still works, offline and free.
# Get one at aistudio.google.com > Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
